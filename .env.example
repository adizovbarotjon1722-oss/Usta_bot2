CLIENT_BOT_TOKEN=your_client_bot_token_here
DRIVER_BOT_TOKEN=your_driver_bot_token_here
ADMIN_IDS=123456789
DATABASE_URL=sqlite+aiosqlite:///bot.db
ADMIN_PANEL_PASSWORD=changeme
ADMIN_PANEL_SECRET_KEY=change-this-to-a-long-random-string
OSRM_BASE_URL=http://router.project-osrm.org

# Payme (https://business.payme.uz) - to'ldirmasangiz, Payme tugmasi ko'rsatilmaydi
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Click (https://my.click.uz) - to'ldirmasangiz, Click tugmasi ko'rsatilmaydi
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Xatolarni kuzatish (ixtiyoriy) - https://sentry.io da bepul akkaunt ochib olish mumkin
SENTRY_DSN=

# Platforma komissiyasi (foizda) va referal bonusi (so'mda)
PLATFORM_COMMISSION_PERCENT=15
REFERRAL_BONUS_AMOUNT=5000
FIRST_ORDER_DISCOUNT_PERCENT=15

# "Ochiq marshrut" (mijoz yo'l ko'rsatib boradigan) safar narxlash
OPEN_ROUTE_BASE_FARE=5000
OPEN_ROUTE_PRICE_PER_MINUTE=1000
OPEN_ROUTE_MIN_FARE=10000

# Bekor qilish siyosati: shu vaqt oynasida shuncha marta bekor qilsa cheklanadi
CANCEL_LIMIT=3
CANCEL_WINDOW_HOURS=24

# Mobil ilova (Flutter) uchun: JWT token va SMS orqali kirish
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRY_DAYS=30
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
# SMS_PROVIDER bo'sh qoldirilsa, SMS kod real yuborilmaydi, o'rniga API javobida
# "dev_code" sifatida qaytadi (development/sinov uchun qulay). Productionda "eskiz" qiling.
SMS_PROVIDER=
SMS_API_EMAIL=
SMS_API_PASSWORD=
SMS_SENDER_NAME=4546
